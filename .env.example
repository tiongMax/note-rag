# FastAPI
APP_NAME=Note RAG
APP_ENVIRONMENT=development
API_AUTH_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
MAX_REQUEST_BYTES=12582912
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_ENABLED=true
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=200
CHUNK_OVERLAP=20
MAX_UPLOAD_BYTES=10485760
UPLOAD_STORAGE_PATH=data/uploads
FRONTEND_DIST_PATH=frontend/dist
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_RRF_K=60
CACHE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
RETRIEVAL_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_TTL_SECONDS=3600
CONTEXT_CANDIDATE_K=20
CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_TOKENS=1200
RERANK_WEIGHT=0.7
RERANKER_BACKEND=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_BATCH_SIZE=16
CHAT_MODEL=gemini-3.5-flash
CHAT_TEMPERATURE=0.1
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_TOKENS=2000
BACKGROUND_WORKER_ENABLED=true
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_TIMEOUT_SECONDS=300

# PostgreSQL
DATABASE_URL=postgresql+psycopg://langchain:langchain@localhost:6024/langchain
DATABASE_ECHO=false
POSTGRES_USER=langchain
POSTGRES_PASSWORD=langchain
POSTGRES_DB=langchain
APP_PORT=8001
